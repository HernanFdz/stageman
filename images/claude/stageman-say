#!/usr/bin/env node
// Speaks on the channel bound to this job's project.
//
// One argument, the message; everything else comes from the environment, which
// is what `docs/decisions/0009-jobs-hold-their-own-platform-credentials.md`
// chose over hosting a tool the agent calls over the protocol connection. The
// agent runs a command, and the command already knows where to speak.
//
// Named for saying rather than for asking, and for the act rather than for
// Slack. A job asks a question with it, and equally says that it finished or
// that it is stuck — and `docs/conventions.md` §2 defines a channel as
// somewhere a job speaks into, not somewhere it interrogates. A second channel
// changes what is below this line and nothing above it: not the name, not the
// kickoff prompt that teaches it, and not the snapshot test on that prompt.
//
// Node rather than a shell script, and that is not a preference. The message is
// written by an agent, so it arrives with whatever quoting, newlines and
// backslashes the agent felt like using; building JSON by interpolating that
// into a here-document is the injection this avoids by not existing. Node is in
// the base image already, `JSON.stringify` is correct by construction, and
// `fetch` needs nothing installed.

// Wrapped in a function rather than written with top-level `await`, which
// would make this a module — and whether an extensionless file is treated as
// one depends on a Node flag that changed default mid-release. It would work
// here and fail in the image, or the reverse, and the only place that shows up
// is a job that cannot speak. Nothing about this needs module scope.
const ENDPOINT = "https://slack.com/api/chat.postMessage";

// **Read by an agent, so it is instruction rather than reference.** Agents
// reach for `--help` before using an unfamiliar command, which is how this
// came to exist: without it the flag was taken as the message and "--help"
// was posted to the channel, twice, before anybody noticed.
const USAGE = `usage: stageman-say '<what to say>'

Says one thing on the channel this project is bound to, in the thread of
whatever is being answered. Takes exactly one argument, which is the whole
message — there are no other options.

  stageman-say 'I have opened a pull request for the parser fix.'

Use -- first if the message itself begins with a dash:

  stageman-say -- '-- and then the second point'`;

// The single argument a tool here takes, or `null` when it has already said
// what it needed to and the caller should stop.
//
// Shared shape between both tools in this image: help on request, a refusal
// for anything else that looks like an option, and `--` to say that what
// follows is the message however it begins. Without the refusal, a mistyped
// flag is silently published to a channel, which is the failure this exists
// to prevent rather than a tidiness.
function only(args, usage) {
  if (args.length === 1 && (args[0] === "--help" || args[0] === "-h")) {
    console.log(usage);
    process.exit(0);
  }

  const given = args[0] === "--" ? args.slice(1) : args;
  if (args[0] !== "--" && typeof args[0] === "string" && args[0].startsWith("-")) {
    console.error(`stageman-say: ${args[0]} is not an option.\n`);
    console.error(usage);
    process.exit(2);
  }
  if (given.length !== 1 || given[0].trim() === "") {
    console.error(usage);
    process.exit(2);
  }
  return given[0];
}

async function say() {
  const message = only(process.argv.slice(2), USAGE);
  if (message === null) {
    return;
  }

  const token = process.env.STAGEMAN_SLACK_TOKEN;
  const channel = process.env.STAGEMAN_SLACK_CHANNEL;
  if (!token || !channel) {
    // The ordinary case for a project with nothing bound, not a fault. Said
    // plainly because the agent reads this and should stop rather than retry.
    console.error(
      "No channel is bound to this project, so there is nobody to say this to.",
    );
    process.exit(3);
  }

  // A thread is addressed by its parent message and the channel together: the
  // identifier is a message timestamp, and a timestamp is unique only within
  // one channel. So `channel` is required whether or not this is threaded.
  //
  // It stays a string the whole way. It looks like a number and is not one —
  // parsed as a float it loses the microseconds and addresses no message, and
  // the failure reads like a permissions problem rather than a rounding one.
  //
  // **Read from a file rather than the environment, and that is the whole
  // reason this file exists.** A container's environment is fixed when it is
  // created and no runtime can change it on restart, so a variable can only
  // carry a value constant for the container's whole life. A job's thread is;
  // a foreman's is not, because one long-lived container answers a different
  // thread every turn. The daemon writes this before each start.
  //
  // No file means speak at the root of the channel, which is a real answer
  // rather than a missing one.
  const payload = { channel, text: message };
  let thread = null;
  try {
    thread = require("node:fs").readFileSync("/tmp/stageman-thread", "utf8").trim();
  } catch {
    thread = null;
  }
  if (thread) {
    payload.thread_ts = thread;
  }

  let answer;
  try {
    answer = await fetch(ENDPOINT, {
      method: "POST",
      headers: {
        // Never logged, and never an argument to anything: a credential on a
        // command line is readable from the process table, and an agent that
        // runs `ps` puts it in a transcript that leaves this machine.
        authorization: `Bearer ${token}`,
        "content-type": "application/json; charset=utf-8",
      },
      body: JSON.stringify(payload),
    });
  } catch (failure) {
    console.error(`The channel could not be reached: ${failure.message}`);
    process.exit(1);
  }

  // **A refusal arrives as 200.** Slack answers `{"ok": false, "error": "..."}`
  // with a perfectly successful status, so a check of the status alone reports
  // every bad token and every wrong channel as a message delivered. That is the
  // one mistake worth guarding here, because its failure mode is silence: the
  // agent believes it asked, stops as instructed, and nobody was ever told.
  if (!answer.ok) {
    console.error(`The channel answered ${answer.status}.`);
    process.exit(1);
  }

  const body = await answer.json();
  if (!body.ok) {
    console.error(`The channel refused it: ${body.error}`);
    process.exit(1);
  }

  console.log("Said it.");
}

say();
