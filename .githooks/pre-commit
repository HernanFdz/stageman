#!/bin/sh
# Runs the gate before a commit is allowed.
#
# It runs `just check` and nothing narrower, deliberately. A hook that checks a
# *subset* becomes a second definition of what passing means, and the two
# definitions drift — at which point "it committed fine locally" and "CI is
# red" are both true and nobody can say which is wrong.
#
# Three things this is not, worth knowing before relying on it:
#
#   * Not automatic. Git does not clone hooks. It arrives with `just hooks`,
#     which points `core.hooksPath` here, and a fresh clone that never runs
#     that has no hook at all.
#   * Not a barrier. `git commit --no-verify` skips it, by design and by git's
#     design. That is a feature — offline, `cargo deny` cannot reach the
#     advisory database and the gate fails for a reason unrelated to the change.
#   * Not the thing that protects the default branch. That is the workflow in
#     `.github/workflows/gate.yml` plus a rule requiring it to pass before a
#     pull request may merge. Those cannot be bypassed from a laptop, and this
#     can.
#
# What it is: the fastest possible way to find out, which is worth about three
# seconds.
set -e

if ! command -v just >/dev/null 2>&1; then
    echo "pre-commit: 'just' is not installed — see AGENTS.md" >&2
    echo "pre-commit: commit with --no-verify to skip this check" >&2
    exit 1
fi

just check
