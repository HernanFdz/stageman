
/target

# Working notes: session state, open questions, upstream observations.
# Carries state, never authority — anything explaining why tracked code is
# the way it is belongs in docs/ instead.
.local/

# cargo-mutants writes its report here, and `just mutants` runs on every
# machine and in CI. Untracked because it is derived: the finding that matters
# is the exit code, and the report is regenerated by rerunning it.
/mutants.out*/

# Compiled by `dx` from `app/tailwind.css` — see .quality/generated-paths.
app/assets/styles.css

# What `just build` copies out of `dx`'s output tree, one directory per target.
# Derived twice over — a build artifact of a build artifact — and the thing it
# holds is a release binary, which has no business in git either way.
/dist
